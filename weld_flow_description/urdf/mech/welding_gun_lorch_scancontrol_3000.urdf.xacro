<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="end_effector" params="prefix">
    
    <link name="welding_gun_link">
      <inertial>
        <origin xyz="-0.063966723890025 0.0507342971013102 -0.279018970359549" rpy="0 0 0" />
        <mass value="1.76093615205291" />
        <inertia ixx="0.0048143448063882" ixy="-8.94621372608532E-05" ixz="-0.00151145048825125" iyy="0.0097571665662651" iyz="-0.000167961449930583" izz="0.00691320517040876" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find weld_flow_description)/meshes/welding_guns/welding_gun_lorch_scancontrol_3000.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find weld_flow_description)/meshes/welding_guns/welding_gun_lorch_scancontrol_3000_collision.STL"/>
        </geometry>
      </collision>
    </link>

    <link name="tcp_welding_gun_link"/>


    <joint name="tcp_welding_gun_joint" type="fixed">
      <origin xyz="0.00132 -0.00363 0.42954" rpy="3.1416 -2.3561 -1.571"/>
      <parent link="ft_sensor_link"/>
      <child link="tcp_welding_gun_link"/>
    </joint>

    <joint name="welding_gun_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="tcp_welding_gun_link"/>
      <child link="welding_gun_link"/>
    </joint>


    <gazebo reference="welding_gun_link">
      <visual>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </gazebo>
      
      
  </xacro:macro>
</robot>